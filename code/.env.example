# Copy to .env and fill in. With no key set (or MOCK_PROVIDER=1) the gateway
# runs in mock mode: it returns a canned reply so you can test the pipeline
# offline, with no API key and no cost.
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_API_KEY=
DEFAULT_MODEL=gpt-4o-mini
TOKEN_BUDGET=8000
MOCK_PROVIDER=1
